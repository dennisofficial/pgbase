{
  "name": "@workspace/pgbase",
  "version": "0.0.0",
  "description": "Self-hosted Postgres BaaS for NestJS + Prisma: RLS-guarded live queries over a typed client SDK (CQS)",
  "license": "MIT",
  "author": "Dennis Lysenko",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": { "types": "./src/index.ts", "default": "./dist/index.mjs" },
      "require": { "types": "./src/index.ts", "default": "./dist/index.js" }
    },
    "./nest": {
      "import": { "types": "./src/nest/index.ts", "default": "./dist/nest/index.mjs" },
      "require": { "types": "./src/nest/index.ts", "default": "./dist/nest/index.js" }
    },
    "./client": {
      "import": { "types": "./src/client/index.ts", "default": "./dist/client/index.mjs" },
      "require": { "types": "./src/client/index.ts", "default": "./dist/client/index.js" }
    },
    "./react": {
      "import": { "types": "./src/react/index.ts", "default": "./dist/react/index.mjs" },
      "require": { "types": "./src/react/index.ts", "default": "./dist/react/index.js" }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "nodemon",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:up": "docker compose up -d",
    "example:down": "docker compose down",
    "example:api": "pnpm --filter @pgbase-example/api dev",
    "example:web": "pnpm --filter @pgbase-example/web dev"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pg-types": "^4.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "react": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "@reduxjs/toolkit": { "optional": true },
    "react": { "optional": true },
    "socket.io": { "optional": true },
    "socket.io-client": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  }
}
