{
  "name": "@dltech/pgbase",
  "version": "0.1.0",
  "description": "Self-hosted Postgres BaaS for NestJS + Prisma: RLS-guarded live queries over a typed client SDK (CQS)",
  "license": "MIT",
  "author": "Dennis Lysenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisofficial/pgbase.git"
  },
  "homepage": "https://github.com/dennisofficial/pgbase#readme",
  "bugs": {
    "url": "https://github.com/dennisofficial/pgbase/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "nestjs",
    "prisma",
    "rls",
    "row-level-security",
    "live-query",
    "realtime",
    "subscriptions",
    "baas",
    "cqs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.mts",
        "default": "./dist/nest/index.mjs"
      },
      "require": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.mts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.ts",
        "default": "./dist/query/index.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      }
    },
    "./policy": {
      "import": {
        "types": "./dist/policy/index.d.mts",
        "default": "./dist/policy/index.mjs"
      },
      "require": {
        "types": "./dist/policy/index.d.ts",
        "default": "./dist/policy/index.js"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context/index.d.mts",
        "default": "./dist/context/index.mjs"
      },
      "require": {
        "types": "./dist/context/index.d.ts",
        "default": "./dist/context/index.js"
      }
    },
    "./read": {
      "import": {
        "types": "./dist/read/index.d.mts",
        "default": "./dist/read/index.mjs"
      },
      "require": {
        "types": "./dist/read/index.d.ts",
        "default": "./dist/read/index.js"
      }
    },
    "./wal": {
      "import": {
        "types": "./dist/wal/index.d.mts",
        "default": "./dist/wal/index.mjs"
      },
      "require": {
        "types": "./dist/wal/index.d.ts",
        "default": "./dist/wal/index.js"
      }
    },
    "./live": {
      "import": {
        "types": "./dist/live/index.d.mts",
        "default": "./dist/live/index.mjs"
      },
      "require": {
        "types": "./dist/live/index.d.ts",
        "default": "./dist/live/index.js"
      }
    },
    "./transport": {
      "import": {
        "types": "./dist/transport/index.d.mts",
        "default": "./dist/transport/index.mjs"
      },
      "require": {
        "types": "./dist/transport/index.d.ts",
        "default": "./dist/transport/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "release": "changeset version",
    "dev": "nodemon",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:up": "docker compose up -d",
    "example:down": "docker compose down",
    "example:api": "pnpm --filter @pgbase-example/api dev",
    "example:web": "pnpm --filter @pgbase-example/web dev"
  },
  "bin": {
    "pgbase": "./dist/generator/bin.js"
  },
  "dependencies": {
    "@prisma/generator-helper": "^7.9.1",
    "pg": "^8.13.1",
    "pg-logical-replication": "^2.5.0",
    "pg-types": "^4.0.2",
    "superjson": "^2.2.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@prisma/client": "^7.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "react": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@reduxjs/toolkit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@prisma/adapter-pg": "7.9.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
