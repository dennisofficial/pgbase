// Deliberately hostile example schema.
//
// Not a realistic app schema — every model here exists to exercise a metadata or query feature
// that is known to be awkward, and it doubles as the fixture for the differential property suite.
// Each model file says what it is trying to break.
//
// Split across models/ on purpose: folder schemas are what Prisma recommends, so consumers will
// use them, and the generator has to be exercised against one. Generator and datasource blocks
// must stay in this file — Prisma requires them at the root of the configured schema directory,
// alongside migrations/.
//
// Partial unique indexes cannot be expressed in Prisma schema and are appended as raw SQL to the
// initial migration.

// moduleFormat is set explicitly: left unset it is inferred from the nearest tsconfig's
// compilerOptions.module. Consumers may pick either, so pgbase must work under both.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator pgbase {
  provider = "pgbase"
  output   = "../src/generated/pgbase"
}

// The connection URL lives in prisma.config.ts — Prisma 7 rejects an inline `url = env(...)` here
// with P1012.
datasource db {
  provider = "postgresql"
}
