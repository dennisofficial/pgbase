// Numeric edge cases. Both `Decimal` and `BigInt` arrive as STRINGS from node-postgres and from
// pgoutput; comparing them with a bare `<` in JS is wrong at the edges. This model is what the
// per-type comparators of divergence hazard #1 are proved against.

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  /// 18 digits of precision — well past what an IEEE-754 double can represent exactly.
  amount      Decimal  @db.Decimal(18, 4)
  /// int8. `9007199254740993` is not representable as a JS number; keep it a string end to end.
  externalRef BigInt   @map("external_ref")
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, issuedAt])
  @@map("invoices")
}
