// Self-relation. The DMMF spike confirmed `getDMMF()` resolves this correctly
// (`relationFromFields: ["parentId"]`) where the client-side `Prisma.dmmf` does not.

model Thread {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  subject   String
  /// Nullable FK — exercises hazard #3 on a relation scalar, not just a value column.
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent    Thread?  @relation("ThreadTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Thread[] @relation("ThreadTree")

  @@index([orgId, parentId])
  @@map("threads")
}
