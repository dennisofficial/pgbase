// Tenancy. `orgId` is the routing column for almost every subscription, and the argument of
// every RLS read policy.

model Org {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members   Membership[]
  jobs      Job[]
  threads   Thread[]
  invoices  Invoice[]

  @@map("orgs")
}

model User {
  id        String       @id @default(uuid()) @db.Uuid
  /// Deliberately NOT citext. Under citext, PG would compare case-insensitively while JS would
  /// not, and the snapshot would disagree with the live matcher forever. Filterable columns may
  /// not be citext; this proves the non-citext path stays consistent.
  email     String       @unique
  name      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members   Membership[]
  watching  JobWatcher[]

  @@map("users")
}

/// Composite primary key where both halves are foreign keys. A composite key that resolved to
/// "no PK" would silently drop this table out of the WAL pipeline instead of failing.
model Membership {
  orgId  String     @map("org_id") @db.Uuid
  userId String     @map("user_id") @db.Uuid
  role   MemberRole @default(MEMBER)

  org    Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER

  @@map("member_role")
}
