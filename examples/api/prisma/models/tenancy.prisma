// Tenancy. `orgId` is the routing column for almost every subscription (docs/DESIGN.md §6),
// and the argument of every RLS read policy.

model Org {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members   Membership[]
  jobs      Job[]
  threads   Thread[]
  invoices  Invoice[]

  @@map("orgs")
}

model User {
  id        String       @id @default(uuid()) @db.Uuid
  /// Deliberately NOT citext. Equality is case-sensitive in both JS and PG here; under citext PG
  /// would compare case-insensitively while JS would not, and the snapshot would disagree with
  /// the live matcher forever. §4.2 bans citext from filterable columns for exactly this reason —
  /// this column is here to prove the non-citext path stays consistent.
  email     String       @unique
  name      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  members   Membership[]
  watching  JobWatcher[]

  @@map("users")
}

/// Composite primary key where both halves are foreign keys. The registry must surface
/// `primaryKey.fields` for this — §7.5 rejects no-PK tables at boot, and a composite PK that
/// reads as "no PK" would take this table out of the WAL pipeline silently.
model Membership {
  orgId  String     @map("org_id") @db.Uuid
  userId String     @map("user_id") @db.Uuid
  role   MemberRole @default(MEMBER)

  org    Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER

  @@map("member_role")
}
