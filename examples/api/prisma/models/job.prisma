// The main workload cluster — the models most live subscriptions target.

model Job {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  name      String
  status    JobStatus    @default(QUEUED)
  priority  Int          @default(0)
  /// A real Postgres text[]. `has` / `hasSome` must agree between the compiled SQL and the
  /// in-memory evaluator.
  labels    String[]     @default([])
  /// jsonb with a PLAIN LITERAL default. Function defaults re-emit on every migrate; never use one.
  metadata  Json         @default("{}")
  /// Nullable on purpose: `status != 'DONE'` must not include these rows in JS while excluding
  /// them in SQL. The NULL-lifting rewrite is what keeps the two interpreters agreeing.
  closedAt  DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  settings  JobSettings?
  tasks     Task[]
  watchers  JobWatcher[]
  /// Implicit m2m. Prisma hides the join table (`_JobToTag`) from every DMMF variant, so its
  /// physical shape has to come from pg_catalog.
  tags      Tag[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@map("jobs")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("job_status")
}

/// 1:1 companion table whose primary key IS its foreign key. The DMMF reports `isId` on a
/// relation scalar here, which is the shape that breaks naive registry builders.
model JobSettings {
  jobId         String @id @map("job_id") @db.Uuid
  concurrency   Int    @default(1)
  /// Must never appear in a transform output. The boot probe proves a non-view column is neither
  /// returned nor filterable — if this one were filterable, a `{ startsWith: 'a' }` oracle would
  /// extract it one character at a time.
  webhookSecret String @map("webhook_secret")

  job           Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_settings")
}

model Task {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  title     String
  done      Boolean  @default(false)
  /// Array-of-ids stored as jsonb rather than a Postgres array, so the registry must not assume
  /// `Json` always means an object.
  blockedBy Json     @default("[]") @map("blocked_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([orgId, jobId])
  @@map("tasks")
}

/// Explicit m2m through a join model, as opposed to Job<->Tag's implicit one. Both shapes must
/// resolve, because a one-shot `include` has to traverse either.
model JobWatcher {
  jobId    String    @map("job_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  notifyAt DateTime? @map("notify_at") @db.Timestamptz(6)

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@map("job_watchers")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  jobs Job[]

  @@map("tags")
}
