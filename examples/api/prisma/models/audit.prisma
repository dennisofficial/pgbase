// Deliberately has NO tenant column.
//
// The subscription router keys on the highest-selectivity equality column present in nearly every
// subscription for a table, which is not always a tenant column — some schemas have no tenancy at
// all. This model proves the wildcard bucket works when no such column exists, and it is the one
// table where every subscription must be tested on every change.

model AuditLog {
  /// autoincrement int8 rather than a uuid — a second BigInt shape, and a PK whose values are
  /// ordered, which the keyset cursor can use.
  id      BigInt   @id @default(autoincrement())
  action  String
  actorId String?  @map("actor_id") @db.Uuid
  at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([at])
  @@map("audit_log")
}
