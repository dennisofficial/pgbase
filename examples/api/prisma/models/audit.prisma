// Deliberately has NO tenant column.
//
// §6 says the routing key is "the highest-selectivity equality column present in nearly every
// subscription for that table", NOT "the tenant column" — rs-crm has no tenancy at all. This
// model is what proves the wildcard bucket works when no such column exists, and it is the one
// table where every subscription must be tested on every change.

model AuditLog {
  /// autoincrement int8 rather than a uuid — a second BigInt shape, and a PK whose values are
  /// ordered, which the keyset cursor can use.
  id      BigInt   @id @default(autoincrement())
  action  String
  actorId String?  @map("actor_id") @db.Uuid
  at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([at])
  @@map("audit_log")
}
